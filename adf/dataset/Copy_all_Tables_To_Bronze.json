{
	"name": "Copy_all_Tables_To_Bronze",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ADLS_GEN2",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"SchemaName": {
				"type": "string"
			},
			"TableName": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "@concat(dataset().TableName,'.csv')",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat(dataset().SchemaName,'/',dataset().TableName)",
					"type": "Expression"
				},
				"container": "bronze"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}